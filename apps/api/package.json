{
  "name": "@scm/api",
  "version": "0.1.0",
  "private": true,
  "description": "SCM modular monolith: HTTP API (main.ts) and job worker (worker.ts) share this codebase.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json && node --watch --enable-source-maps dist/main.js",
    "dev:worker": "node --watch --enable-source-maps dist/worker.js",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "seed": "node dist/cli/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@scm/db": "workspace:*",
    "@scm/domain": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "otplib": "12.0.1",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/pg": "8.15.6",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "unplugin-swc": "1.6.0"
  }
}
