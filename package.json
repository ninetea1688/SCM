{
  "name": "scm",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm -r --filter \"./apps/**\" run build",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "dev:infra": "docker compose up -d",
    "dev:api": "pnpm --filter @scm/api dev",
    "dev:worker": "pnpm --filter @scm/api dev:worker",
    "dev:web": "pnpm --filter @scm/web dev",
    "db:generate": "pnpm --filter @scm/db generate",
    "db:migrate": "pnpm --filter @scm/db migrate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm build:packages && pnpm -r run test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
