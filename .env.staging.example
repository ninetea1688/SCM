# Staging env — same docker-compose.prod.yml, separate host/env (deploy.md §Staging).
# Copy to .env.staging on the staging host (never commit it). Generate secrets with:
#   URL-embedded (DB/Redis) passwords: openssl rand -hex 32; others: openssl rand -base64 32
# Staging differences vs prod: sandbox publisher (fake), staging domains, backups to a
# staging dir. Everything else mirrors prod on purpose — staging is the release gate.

# Compose reads the api/worker/migrate env from this same file:
ENV_FILE=.env.staging

DOMAIN=staging.scm.example.go.th
MEDIA_DOMAIN=media.staging.scm.example.go.th
ACME_EMAIL=it@example.go.th
SCM_VERSION=latest

POSTGRES_PASSWORD=
SCM_APP_DB_PASSWORD=
SCM_SYSTEM_DB_PASSWORD=
REDIS_PASSWORD=
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups-staging

PUBLIC_BASE_URL=https://staging.scm.example.go.th
WEB_ORIGIN=https://staging.scm.example.go.th
JWT_SECRET=
# id:base64(32 bytes). Rotate by prepending a new key: k2:NEW,k1:OLD
# Staging may share the prod key ring; use a fresh one for a clean staging host.
TOKEN_ENC_KEYS=k1:
S3_BUCKET=scm-media-staging
S3_ACCESS_KEY=scm
S3_SECRET_KEY=
# Platforms/browsers fetch signed media from here (must be public HTTPS)
S3_PUBLIC_ENDPOINT=https://media.staging.scm.example.go.th

# fake = in-memory sandbox adapters; no Meta App needed. Flip to live only when the
# staging Meta App + channel are ready and the domain is verified.
PUBLISHER_MODE=fake
# Required while PUBLISHER_MODE=fake (prod guard). Never set this on the prod host.
ALLOW_FAKE_PUBLISHER=true
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
LINE_NOTIFY_CHANNEL_TOKEN=
LINE_NOTIFY_GROUP_ID=
# Empty disables the email channel; point at a test SMTP or Mailpit when needed.
SMTP_URL=
SENTRY_DSN=
# Mirror prod: owner/admin logins require 2FA in staging too.
AUTH_ENFORCE_MFA=true
LOG_LEVEL=info
