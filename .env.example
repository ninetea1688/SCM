# Copy to .env.prod on the server (never commit it). Generate secrets with:
#   openssl rand -base64 32
DOMAIN=scm.example.go.th
MEDIA_DOMAIN=media.scm.example.go.th
ACME_EMAIL=it@example.go.th
SCM_VERSION=latest

POSTGRES_PASSWORD=
SCM_APP_DB_PASSWORD=
SCM_SYSTEM_DB_PASSWORD=
REDIS_PASSWORD=
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups

PUBLIC_BASE_URL=https://scm.example.go.th
WEB_ORIGIN=https://scm.example.go.th
JWT_SECRET=
# id:base64(32 bytes). Rotate by prepending a new key: k2:NEW,k1:OLD
TOKEN_ENC_KEYS=k1:
S3_BUCKET=scm-media
S3_ACCESS_KEY=scm
S3_SECRET_KEY=
# Platforms fetch signed media from here (must be public HTTPS)
S3_PUBLIC_ENDPOINT=https://media.scm.example.go.th

PUBLISHER_MODE=live
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
LINE_NOTIFY_CHANNEL_TOKEN=
LINE_NOTIFY_GROUP_ID=
LOG_LEVEL=info
